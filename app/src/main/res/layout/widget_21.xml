<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1: Restbetrag, Balken, Plus -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="9dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/w_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="übrig"
                android:textColor="#8A8A8A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="–"
                android:textColor="#F2F2F2"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/add_bg"
            android:contentDescription="Ausgabe eintragen"
            android:scaleType="center"
            android:src="@drawable/ic_plus" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="5dp">

        <ProgressBar
            android:id="@+id/w_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/bar_white" />

        <ProgressBar
            android:id="@+id/w_bar_red"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/bar_red"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
