<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 rund: Kreis mit Ring nach Kategorien, oben Restbetrag, Plus in der Mitte -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_open"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_circle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/w_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Ausgaben nach Kategorie"
        android:scaleType="fitCenter"
        android:src="@drawable/circle_bg" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/w_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:text="–"
            android:textColor="#F2F2F2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/w_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/add_bg"
            android:contentDescription="Ausgabe eintragen"
            android:scaleType="center"
            android:src="@drawable/ic_plus_small" />

        <TextView
            android:id="@+id/w_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:letterSpacing="0.04"
            android:text="übrig"
            android:textColor="#8A8A8A"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
